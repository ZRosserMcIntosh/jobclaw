# Same as .env.local but with placeholder values — safe to commit.

# The shared Railgun Supabase project (nwdhomxzljairsddcgtp).
#
# NOTE: the project this app originally used (rsmpiwiitkbdynanzdst) no
# longer exists — it resolves NXDOMAIN. Every route here depends on
# Supabase, so these two values must point at the live project or nothing
# in the app works, including login.
#
# Copy both from: Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://nwdhomxzljairsddcgtp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Not required, and preferably never set here. The waitlist writes through
# an insert-only RLS policy with the publishable key above, so no
# RLS-bypassing credential needs to exist in this deployment. If you set
# it, lib/ai/match-jobs.ts will pick it up in preference to the
# publishable key.
# SUPABASE_SERVICE_ROLE_KEY=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Unused — there is no billing integration in this app yet, and the
# pricing page deliberately has no checkout.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
